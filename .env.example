NODE_ENV=development
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT_REF].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SEED_ADMIN_PASSWORD="password"
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Photos: a PRIVATE Supabase Storage bucket, accessed with the service-role key.
# Without these, development stores photos in .data/photos.
UPLOAD_BUCKET=repair-ticket-photos
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: a separate database for integration tests (migrate it with
# `npm run test:db:prepare`). Leave empty to skip them.
TEST_DATABASE_URL=

# Optional: 32 random bytes (base64) used to encrypt device passwords.
# Generate with: openssl rand -base64 32. Without it a key is derived from JWT_SECRET.
DEVICE_PASSWORD_KEY=
