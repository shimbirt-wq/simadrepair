generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  TECHNICIAN
  LEAD_TECHNICIAN
  ADMIN
}

/// One ticket lifecycle; see docs/platform/spec.md and src/lib/tickets/workflow.ts.
enum TicketStatus {
  SUBMITTED
  RECEIVED
  IN_REPAIR
  WAITING_FOR_PARTS
  ACTION_NEEDED
  CANNOT_REPAIR_PROPOSED
  CANNOT_BE_REPAIRED
  READY_FOR_PICKUP
  COLLECTED
  CANCELLED
}

enum RequesterType {
  STUDENT
  LECTURER
  STAFF
}

enum RepairEventType {
  TICKET_CREATED
  STATUS_CHANGED
  CUSTODY_CHANGED
  TECHNICIAN_ASSIGNED
  READY_FOR_PICKUP
  PICKUP_CONFIRMED
  TICKET_CLOSED
  TICKET_CANCELLED
  CHECKED_IN
  TECHNICIAN_REASSIGNED
  TICKET_CLAIMED
  TICKET_RELEASED
  REPAIR_STARTED
  REPAIR_BLOCKED
  REPAIR_RESUMED
  CANNOT_REPAIR_PROPOSED
  CANNOT_REPAIR_CONFIRMED
  CANNOT_REPAIR_REJECTED
  STEP_UNDONE
  NOTE_ADDED
  MESSAGE_SENT
  RATED
}

model User {
  id                 String               @id @default(cuid())
  fullName           String               @map("full_name")
  universityId       String?              @unique @map("university_id")
  faculty            String?
  department         String?
  phone              String?
  email              String               @unique
  passwordHash       String               @map("password_hash")
  role               UserRole             @default(TECHNICIAN)
  isActive           Boolean              @default(true) @map("is_active")
  /// Hardware, Software/OS, Network (LD6).
  skills             String[]             @default([])
  /// Volunteer access ends after this day (the event's last day). Null = no expiry.
  accessExpiresOn    DateTime?            @map("access_expires_on") @db.Date
  assignedTickets    RepairTicket[]       @relation("TechnicianTickets")
  repairEvents       RepairEvent[]        @relation("RepairEventActor")
  custodyReceived    DeviceCustody[]      @relation("CustodyReceivedBy")
  custodyReleased    DeviceCustody[]      @relation("CustodyReleasedBy")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([role])
  @@index([isActive])
  @@index([faculty])
  @@index([createdAt])
  @@map("users")
}

model Requester {
  id            String         @id @default(cuid())
  requesterType RequesterType  @map("requester_type")
  fullName      String         @map("full_name")
  /// Normalised, e.g. CS383833. Returning requesters are matched on this only.
  universityId  String         @unique @map("university_id")
  faculty       String?
  department    String?
  /// +2526XXXXXXXX
  phone         String
  email         String?
  devices       Device[]
  tickets       RepairTicket[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([requesterType])
  @@index([phone])
  @@index([email])
  @@index([createdAt])
  @@map("requesters")
}

model Device {
  id           String          @id @default(cuid())
  requesterId  String?         @map("requester_id")
  requester    Requester?      @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  deviceType   String          @map("device_type")
  brand        String
  model        String
  operatingSystem String?      @map("operating_system")
  ram          String?
  storageType  String?         @map("storage_type")
  ageBand      String?         @map("age_band")
  serialNumber String?         @map("serial_number")
  assetTag     String?         @map("asset_tag")
  description  String?
  tickets      RepairTicket[]
  custody      DeviceCustody[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([requesterId])
  @@index([serialNumber])
  @@index([assetTag])
  @@index([deviceType])
  @@index([createdAt])
  @@map("devices")
}

/// One Computer Maintenance Week. Its settings drive the request window,
/// public text, WhatsApp messages, tag numbers and the report.
model Event {
  id                   String         @id @default(cuid())
  name                 String
  startsOn             DateTime       @map("starts_on") @db.Date
  endsOn               DateTime       @map("ends_on") @db.Date
  registrationOpensOn  DateTime       @map("registration_opens_on") @db.Date
  registrationClosesOn DateTime       @map("registration_closes_on") @db.Date
  venue                String
  hours                String
  deskWhatsapp         String         @map("desk_whatsapp")
  holdDays             Int            @default(30) @map("hold_days")
  isActive             Boolean        @default(false) @map("is_active")
  lastTagNumber        Int            @default(0) @map("last_tag_number")
  tickets              RepairTicket[]
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("events")
}

model RepairTicket {
  id                    String         @id @default(cuid())
  eventId               String         @map("event_id")
  event                 Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketId              String         @unique @map("ticket_id")
  trackingCode          String?        @unique @map("tracking_code")
  deviceId              String         @map("device_id")
  device                Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requesterId           String?        @map("requester_id")
  requester             Requester?     @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  technicianId          String?        @map("technician_id")
  technician            User?          @relation("TechnicianTickets", fields: [technicianId], references: [id], onDelete: SetNull)
  issueDescription      String         @map("issue_description")
  /// Hand-written sticker number, unique within the event (#001…). Set at check-in.
  tagNumber             Int?           @map("tag_number")
  priority              TicketPriority @default(NORMAL)
  startedAt             DateTime?      @map("started_at")
  /// Repair record (TA6/TA7), required before Ready for pickup.
  repairFaults          String[]       @default([]) @map("repair_faults")
  repairActions         String[]       @default([]) @map("repair_actions")
  repairNote            String?        @map("repair_note")
  testsPassed           String[]       @default([]) @map("tests_passed")
  /// 1–5, given once by the requester after collection.
  rating                Int?
  ratingComment         String?        @map("rating_comment")
  ratedAt               DateTime?      @map("rated_at")
  /// AES-256-GCM ciphertext of the device password (src/lib/secrets). Deleted at pickup and event end.
  devicePasswordEnc     String?        @map("device_password_enc")
  accessoriesLeft       String[]       @default([]) @map("accessories_left")
  wipeAllowed           Boolean        @default(false) @map("wipe_allowed")
  needsPassword         Boolean        @default(false) @map("needs_password")
  consentAt             DateTime?      @map("consent_at")
  problemCategories     String[]       @default([]) @map("problem_categories")
  /// { [category]: { [questionId]: answer } } — see src/lib/intake/diagnosis.ts
  problemAnswers        Json?          @map("problem_answers")
  startedWhen           String?        @map("started_when")
  recentEvents          String[]       @default([]) @map("recent_events")
  errorMessage          String?        @map("error_message")
  photos                TicketPhoto[]
  status                TicketStatus   @default(SUBMITTED)
  events                RepairEvent[]
  custody               DeviceCustody?
  assignedAt            DateTime?      @map("assigned_at")
  completedAt           DateTime?      @map("completed_at")
  readyForPickupAt      DateTime?      @map("ready_for_pickup_at")
  closedAt              DateTime?      @map("closed_at")
  cancelledAt           DateTime?      @map("cancelled_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  @@unique([eventId, tagNumber])
  @@index([eventId])
  @@index([deviceId])
  @@index([requesterId])
  @@index([technicianId])
  @@index([status])
  @@index([status, createdAt])
  @@index([assignedAt])
  @@index([readyForPickupAt])
  @@index([closedAt])
  @@index([createdAt])
  @@map("repair_tickets")
}

model DeviceCustody {
  id                   String        @id @default(cuid())
  ticketId             String        @unique @map("ticket_id")
  ticket               RepairTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  deviceId             String?       @map("device_id")
  device               Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  receivedById         String?       @map("received_by_id")
  receivedBy           User?         @relation("CustodyReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedAt           DateTime?     @map("received_at")
  idChecked            Boolean       @default(false) @map("id_checked")
  conditionChecks      String[]      @default([]) @map("condition_checks")
  condition            String?
  accessoriesReceived  String[]      @default([]) @map("accessories_received")
  storageLocation      String?       @map("storage_location")
  /// EVENT_DESK during the event; IT_OFFICE once uncollected devices are moved after it (D11).
  location             String        @default("EVENT_DESK")
  releasedById         String?       @map("released_by_id")
  releasedBy           User?         @relation("CustodyReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)
  readyForCollectionAt DateTime?     @map("ready_for_collection_at")
  collectedByName      String?       @map("collected_by_name")
  collectedByPhone     String?       @map("collected_by_phone")
  accessoriesReturned  String[]      @default([]) @map("accessories_returned")
  collectedAt          DateTime?     @map("collected_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@index([deviceId])
  @@index([receivedById])
  @@index([releasedById])
  @@index([receivedAt])
  @@index([readyForCollectionAt])
  @@index([collectedAt])
  @@index([createdAt])
  @@map("device_custody")
}

model RepairEvent {
  id          String          @id @default(cuid())
  ticketId    String          @map("ticket_id")
  ticket      RepairTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId     String?         @map("actor_id")
  actor       User?           @relation("RepairEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole   UserRole?       @map("actor_role")
  eventType   RepairEventType @map("event_type")
  statusFrom  String?         @map("status_from")
  statusTo    String?         @map("status_to")
  note        String?
  metadata    Json?
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([ticketId])
  @@index([actorId])
  @@index([eventType])
  @@index([createdAt])
  @@map("repair_events")
}

enum TicketPriority {
  NORMAL
  URGENT
}

enum PhotoKind {
  REQUESTER
  DAMAGE
}

/// A private photo. Requester photos are uploaded before the ticket exists
/// (ticketId null, claimed with uploadToken when the form is sent).
model TicketPhoto {
  id           String        @id @default(cuid())
  ticketId     String?       @map("ticket_id")
  ticket       RepairTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind         PhotoKind
  storagePath  String        @map("storage_path")
  mimeType     String        @map("mime_type")
  sizeBytes    Int           @map("size_bytes")
  uploadToken  String?       @unique @map("upload_token")
  uploadedById String?       @map("uploaded_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@index([createdAt])
  @@map("ticket_photos")
}

/// Fixed-window rate limit counters, shared by every server instance.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@map("rate_limit_buckets")
}
